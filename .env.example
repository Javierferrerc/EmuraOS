# Google Drive (emulator downloads)
GDRIVE_ROOT_FOLDER_ID=your-drive-folder-id-here
GDRIVE_API_KEY=your-drive-api-key-here

# ScreenScraper (metadata)
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# SteamGridDB (cover art)
STEAMGRIDDB_API_KEY=

# Social layer (Supabase) — from your project → Settings → API.
# PUBLIC by design (anon key ships in the client); security is enforced by RLS.
# Without these, social features stay disabled and the launcher works offline.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
