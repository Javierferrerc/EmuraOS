  {
    "id": "retroarch",
    "name": "RetroArch",
    "executable": {
      "win32": "retroarch.exe",
      "darwin": "RetroArch.app/Contents/MacOS/RetroArch",
      "linux": "retroarch"
    },
    "defaultPaths": {
      "win32": [
        "C:\\RetroArch-Win64",
        "C:\\RetroArch",
