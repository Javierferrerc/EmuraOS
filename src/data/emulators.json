      ],
      "darwin": ["/Applications", "~/Applications"],
      "linux": ["/usr/bin", "/usr/local/bin", "~/.local/bin"]
    },
    "systems": ["nes", "snes", "n64", "gb", "gbc", "gba", "megadrive", "mastersystem", "psx"],
